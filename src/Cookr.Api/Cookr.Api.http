@HostAddress = http://localhost:5021
@RecipeId = 2
@IngredientId = 2

GET {{HostAddress}}/
Accept: application/json

### Recipes

### GET recipes
GET {{HostAddress}}/recipes
Accept: application/json

### GET recipes/id
GET {{HostAddress}}/recipes/{{RecipeId}}
Accept: application/json

### POST recipe (rodar de novo com o mesmo título retorna 409 recipe_title_taken)
POST {{HostAddress}}/recipes
Content-Type: application/json

{
    "title": "Bolo de fubá",
    "instructions": "Bata tudo no liquidificador. Asse 40 min a 180°C.",
    "prepTimeMinutes": 50,
    "servings": 10,
    "ingredients": [
        { "name": "Fubá", "quantity": 2, "unit": "cup" },
        { "name": "Ovo", "quantity": 3, "unit": "unit" },
        { "name": "Leite", "quantity": 1, "unit": "cup" }
    ]
}

### PUT recipe
PUT {{HostAddress}}/recipes/{{RecipeId}}
Content-Type: application/json

{
    "title": "Bolo de cenoura (editado)",
    "instructions": "Bata os ovos, óleo e cenoura no liquidificador. Misture com o restante seco. Asse 40min a 180°C. Cubra com calda de chocolate.",
    "prepTimeMinutes": 75,
    "servings": 10,
    "ingredients": [
        { "name": "Cenoura", "quantity": 3, "unit": "unit" },
        { "name": "Ovo", "quantity": 3, "unit": "unit" },
        { "name": "Chocolate em pó", "quantity": 4, "unit": "tablespoon" }
    ]
}

### DELETE recipe
DELETE {{HostAddress}}/recipes/{{RecipeId}}
Accept: application/json

### POST ingredient na recipe
POST {{HostAddress}}/recipes/{{RecipeId}}/ingredients
Content-Type: application/json

{
    "ingredientId": 2,
    "quantity": 3,
    "unit": "unit"
}

### DELETE ingredient da recipe
DELETE {{HostAddress}}/recipes/{{RecipeId}}/ingredients/{{IngredientId}}
Accept: application/json

### Ingredients

### GET ingredients
GET {{HostAddress}}/ingredients
Accept: application/json

### GET ingredients/id
GET {{HostAddress}}/ingredients/{{IngredientId}}
Accept: application/json

### POST ingredient
POST {{HostAddress}}/ingredients
Content-Type: application/json

{
    "name": "Cenoura"
}

### PUT ingredient
PUT {{HostAddress}}/ingredients/{{IngredientId}}
Content-Type: application/json

{
    "name": "Cenoura ralada"
}

### DELETE ingredient
DELETE {{HostAddress}}/ingredients/{{IngredientId}}
Accept: application/json

### PUT recipe cover (multipart, JPEG/PNG/WebP ate 10 MB)
PUT {{HostAddress}}/recipes/{{RecipeId}}/cover
Content-Type: multipart/form-data; boundary=cover

--cover
Content-Disposition: form-data; name="file"; filename="capa.jpg"
Content-Type: image/jpeg

< ./capa.jpg
--cover--

### DELETE recipe cover
DELETE {{HostAddress}}/recipes/{{RecipeId}}/cover